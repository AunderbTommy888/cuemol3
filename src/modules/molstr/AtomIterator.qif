// -*-Mode: C++;-*-
//
// $Id: AtomIterator.qif,v 1.2 2009/01/08 10:27:25 rishitani Exp $

#include "MolAtom.qif"
#include "MolCoord.qif"
#include "MolSelection.qif"

runtime_class AtomIterator
{
  client_hdr "AtomIterator.hpp";
  client_name molstr::AtomIterator;

  scriptable;

  // cloneable option generates instance creation with copy constructor
  cloneable;
  smartptr;

  // The target molecule is set by a method, not a writable property: a
  // property setter calls setupParentData(), which would rename the molecule
  // to "target" and break the nested names ("coloring.multi_grad") that its
  // renderers and undo rely on.
  property object<MolCoord$> target => redirect(getTarget, xxx) (readonly);
  void setTarget(object<MolCoord$>);
  property object<MolSelection$> sel => redirect(getSelection, setSelection);

  void first();
  void next();
  boolean hasMore();
  integer getID();
  object<MolAtom$> get();
  
  string toString();
};
