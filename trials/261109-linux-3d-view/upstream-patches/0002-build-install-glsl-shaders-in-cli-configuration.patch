Subject: build(linux): install the GLSL shaders in the CLI configuration

On Linux, src/CMakeLists.txt builds the CLI configuration
(BUILD_OPENGL_SYSDEP=FALSE) because the X11 sysdep backend is not ported.
All three GLSL_PREPROC calls (sysdep, molvis, xtal) sit behind that switch,
so share/data/shaders is missing from every Linux package. The tritium
Electron renderer (ElecDisplayContext -> WebGL) does not use sysdep, but it
reads those shaders at run time, and fails with
"OcDisplayContext> FATAL ERROR: loadShader(gpu_line) failed!!".

- Move the ogl_core shader lists out of sysdep/CMakeLists.txt into
  sysdep/ogl_core_shaders.cmake (absolute paths), used by sysdep as before.
- Add option INSTALL_GLSL_SHADERS (default ON). When sysdep is not built,
  preprocess the ogl_core shaders through a custom target instead.
- molvis / xtal: preprocess their shaders when BUILD_OPENGL_SYSDEP OR
  INSTALL_GLSL_SHADERS (molvis' GLEW include dirs stay sysdep-only).
- glsl.cmake: on Linux pass -undef -ffreestanding to cpp, so glibc's
  stdc-predef.h licence comment is not copied into every shader.

Verified: the new ogl_core_glsl path builds and installs 30 shaders through
the unmodified GLSL_PREPROC in a standalone CMake harness, byte-identical to
the files the local workaround generates from v3.0.0.554. The full libcuemol2
configure and the sysdep / molvis / xtal paths were not built.

Apply with: git apply <this file>

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 85fcb829..348d5be5 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -81,6 +81,10 @@ message(STATUS "GLEW_FOUND: ${GLEW_FOUND} ${GLEW_LIBRARIES}")
 # stopping in sysdep. Configure with -DENABLE_X11_SYSDEP=ON to build it
 # anyway (for that porting work).
 option(ENABLE_X11_SYSDEP "Build the unported X11 OpenGL sysdep backend" OFF)
+# The tritium Electron renderer reads the preprocessed GLSL shaders at run
+# time whether or not sysdep is built, so the CLI configuration installs
+# them too.
+option(INSTALL_GLSL_SHADERS "Install the preprocessed GLSL shaders (used by tritium)" ON)
 
 if (OPENGL_FOUND AND GLEW_FOUND)
   if (WIN32 OR APPLE OR ENABLE_X11_SYSDEP)
@@ -221,6 +225,13 @@ if (NOT BUILD_MINIMUM_MODULES)
 
   if (BUILD_OPENGL_SYSDEP)
     add_subdirectory(sysdep)
+  elseif (INSTALL_GLSL_SHADERS)
+    # sysdep is not built, but tritium still needs its ogl_core shaders.
+    include(${CMAKE_CURRENT_SOURCE_DIR}/sysdep/ogl_core_shaders.cmake)
+    add_custom_target(ogl_core_glsl)
+    set_target_properties(ogl_core_glsl PROPERTIES
+      SHADER_SOURCES "${OGL_CORE_SHADER_SOURCES}")
+    GLSL_PREPROC(ogl_core_glsl "${OGL_CORE_SHADER_DEPS}")
   endif ()
   
   add_subdirectory(modules/molstr)
diff --git a/src/glsl.cmake b/src/glsl.cmake
index 48129e4f..aa8a2d38 100644
--- a/src/glsl.cmake
+++ b/src/glsl.cmake
@@ -71,6 +71,12 @@ function(GLSL_PREPROC _target SHADER_DEPENDENCIES)
         list(APPEND PREPROCESSOR_FLAGS -P)  # Don't output #line directives
         list(APPEND PREPROCESSOR_FLAGS -C)  # Preserve comments
         list(APPEND PREPROCESSOR_FLAGS -w)  # Suppress warnings
+        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+            # GNU cpp on glibc pre-includes stdc-predef.h, whose licence
+            # comment -C would copy into every shader, and predefines
+            # "linux" / "unix". Neither happens with clang on macOS.
+            list(APPEND PREPROCESSOR_FLAGS -undef -ffreestanding)
+        endif()
         
         # Add include directories
         foreach(INCLUDE_DIR ${SHADER_INCLUDE_DIRS})
diff --git a/src/modules/molvis/CMakeLists.txt b/src/modules/molvis/CMakeLists.txt
index e0887f0a..2b1946d8 100644
--- a/src/modules/molvis/CMakeLists.txt
+++ b/src/modules/molvis/CMakeLists.txt
@@ -77,6 +77,9 @@ IF (BUILD_OPENGL_SYSDEP)
     ${GLEW_INCLUDE_DIRS}
     ${OPENGL_INCLUDE_DIR}
   )
+ENDIF ()
+# The shaders are also used by tritium in the CLI configuration
+IF (BUILD_OPENGL_SYSDEP OR INSTALL_GLSL_SHADERS)
   # GLSL shader files
   SET(GLSL_SHADER_FILES
     sphere_frag.glsl
